---
import type { ImageMetadata } from "astro";
import { getPortfolioData } from "@/utils/data";
import { Image } from "astro:assets";

import cannen from "@/assets/awards/cannen.png";
import guldagg from "@/assets/awards/guldagg.png";
import svenskadesign from "@/assets/awards/svenskadesign.png";

const { awards } = getPortfolioData();

const imageMap: Record<string, ImageMetadata> = {
	"/img/awards/cannen.png": cannen,
	"/img/awards/guldagg.png": guldagg,
	"/img/awards/svenskadesign.png": svenskadesign,
};

const awardsWithImages = awards.map((award) => ({
	...award,
	image: imageMap[award.images],
	href: award.link.startsWith("/") ? award.link : `/${award.link}`,
}));
---

<section id="awards" class="section scroll-mt-20">
	<div class="container">
		<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
			<p class="label-mono">/ Recognition</p>
			<div class="flex items-center gap-3">
				<p class="label-mono hidden opacity-70 sm:block">Verified awards</p>
				<span class="size-2 bg-current" aria-hidden="true"></span>
			</div>
		</div>

		<h2 class="mt-8 max-w-3xl text-4xl font-bold tracking-[-0.04em] md:text-5xl">
			Awards &amp; industry honors.
		</h2>

		<div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
			{
				awardsWithImages.map((award, index) => (
					<a
						href={award.href}
						class="group relative flex h-full flex-col justify-between bg-[#17140f] p-7 text-white transition-colors duration-200 hover:bg-[#221d16] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mustard dark:bg-[#1f1b14] dark:hover:bg-[#2a241b]"
					>
						<div class="flex items-center justify-between gap-3">
							<span class="label-mono text-white/70">HONOR / 0{index + 1}</span>
							<span class="font-pixel bg-mustard px-2.5 py-0.5 text-xs text-ink">
								WINNER
							</span>
						</div>

						<div class="my-9 flex h-36 w-full items-center justify-center">
							{award.image ? (
								<Image
									src={award.image}
									alt={award.name}
									widths={[480, 768]}
									sizes="(max-width: 768px) 100vw, 33vw"
									format="webp"
									quality={85}
									loading="lazy"
									class="max-h-32 w-auto object-contain transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
								/>
							) : (
								<img
									src={award.images}
									alt={award.name}
									loading="lazy"
									class="max-h-32 w-auto object-contain transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
								/>
							)}
						</div>

						<div>
							<h3 class="text-2xl font-bold tracking-[-0.03em] text-white transition-colors group-hover:text-mustard">
								{award.name}
							</h3>
							<p class="mt-2.5 text-sm leading-relaxed text-white/80">{award.description}</p>
							<div class="mt-6 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-widest text-mustard">
								<span>View case study</span>
								<span
									class="transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
									aria-hidden="true"
								>
									&rarr;
								</span>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>


