---
import GitHubContributions from "../components/GitHubContributions";
---

<section id="github-activity" class="block-ink section">
	<div class="container mx-auto px-4">
		<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
			<p class="label-mono">/ GitHub activity</p>
			<div class="flex items-center gap-3">
				<p class="label-mono hidden opacity-70 sm:block">Commit ledger</p>
				<span class="size-2 bg-current" aria-hidden="true"></span>
			</div>
		</div>

		<h2 class="mt-8 max-w-3xl text-4xl md:text-5xl font-bold tracking-[-0.04em]">
			A year on GitHub.
		</h2>
		<p class="mt-4 max-w-2xl text-lg leading-snug opacity-80">
			A visual record of coding activity and daily contributions over time.
		</p>

		<div class="mt-10">
			<GitHubContributions username="ehsanpo" client:load />
		</div>
	</div>
</section>
