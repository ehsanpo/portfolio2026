---
import Island from "@/components/hero/Island.astro";
import { getPortfolioData, getPortfolioItems } from "@/utils/data";

const { contact, awards, certifications, companies } = getPortfolioData();
const portfolioItems = await getPortfolioItems();

const tickerItems = [
	`${contact.yearsOfExperience} years shipping`,
	`${portfolioItems.length} projects completed`,
	`${awards.length} design & advertising awards`,
	`${certifications.length} certifications`,
	`${companies.length} companies & agencies`,
	"Full-Stack Engineer & Music Producer",
	`Based in ${contact.location}`,
];
---

<section id="hero" class="block-tomato relative overflow-hidden pt-24 md:pt-28">
	<div class="container mx-auto px-4 relative">
		<h1 class="sr-only">{contact.name}</h1>

		<div class="relative z-10 grid grid-cols-1 items-center gap-8 lg:grid-cols-12 pt-4 pb-12">
			<div class="lg:col-span-5 relative z-10">
				<p class="label-mono mb-3">/ {contact.location}</p>
				<p class="text-balance text-4xl leading-[1.02] font-bold tracking-[-0.04em] md:text-[3.4rem] text-ink">
					{contact.role} building web, desktop &amp; audio tools.
				</p>
				<p class="mt-6 max-w-md text-lg leading-snug text-ink/90">
					{contact.description}
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="#selected-work" class="key bg-ink text-cream">
						See the bench
					</a>
					<a href="/contact" class="key bg-cream text-ink">
						Call the studio
					</a>
				</div>
				<dl class="mt-8 grid grid-cols-2 gap-4 border-t-[1.5px] border-ink pt-4">
					<div>
						<dd class="font-pixel text-4xl leading-none text-ink">{contact.yearsOfExperience}</dd>
						<dt class="label-mono mt-1 text-ink/80">Years of experience</dt>
					</div>
					<div>
						<dd class="font-pixel text-4xl leading-none text-ink">{portfolioItems.length}</dd>
						<dt class="label-mono mt-1 text-ink/80">Projects completed</dt>
					</div>
				</dl>
			</div>

			<div class="lg:col-span-7 flex flex-col items-center justify-center relative z-0 lg:-mt-8">
				<div class="w-full flex items-center justify-center [&_svg]:w-full [&_svg]:max-w-[560px] [&_svg]:h-auto">
					<Island />
				</div>
				<p class="label-mono pt-3 w-full text-right text-ink">
					Fig. 01 / Interactive island &amp; workspace. Click objects to explore.
				</p>
			</div>
		</div>
	</div>
</section>

<div class="block-ink overflow-hidden py-3 border-y-[1.5px] border-ink">
	<div class="flex w-max animate-marquee motion-reduce:animate-none">
		<ul class="flex shrink-0 items-center">
			{
				tickerItems.map((item) => (
					<li class="label-mono flex items-center whitespace-nowrap">
						<span class="px-6">{item}</span>
						<span class="size-2 bg-mustard shrink-0" aria-hidden="true" />
					</li>
				))
			}
		</ul>
		<ul class="flex shrink-0 items-center" aria-hidden="true">
			{
				tickerItems.map((item) => (
					<li class="label-mono flex items-center whitespace-nowrap">
						<span class="px-6">{item}</span>
						<span class="size-2 bg-mustard shrink-0" aria-hidden="true" />
					</li>
				))
			}
		</ul>
	</div>
</div>
