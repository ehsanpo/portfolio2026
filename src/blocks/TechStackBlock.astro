---
import SkillsInfo from "@/components/Skillsinfo";
import StackCard from "@/components/StackCard";
import { getPortfolioData } from "@/utils/data";

const { stacks } = getPortfolioData();
const { showAll = false } = Astro.props;
const visibleStacks = stacks.slice(0, showAll ? stacks.length : 5);
---

<section id="stacks" class="block-mustard section">
	<div class="container mx-auto px-4">
		<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
			<p class="label-mono">/ Technical specifications</p>
			<div class="flex items-center gap-3">
				<p class="label-mono hidden opacity-70 sm:block">Production stack</p>
				<span class="size-2 bg-current" aria-hidden="true"></span>
			</div>
		</div>

		<div class="mt-8 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
			<div>
				<h2 class="max-w-3xl text-4xl md:text-5xl font-bold tracking-[-0.04em]">
					Stacks, architecture &amp; tools.
				</h2>
				<p class="mt-4 max-w-xl text-lg leading-snug text-ink/85">
					Core languages, frameworks, and infrastructure used across production systems, rated by hands-on depth and years in the field.
				</p>
			</div>
			<SkillsInfo />
		</div>

		<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-5">
			{visibleStacks.map((stack) => <StackCard {...stack} client:load />)}
		</div>

		{
			!showAll && (
				<div class="mt-10 flex justify-end">
					<a href="/skills" class="key bg-ink text-cream">
						Full stack &amp; timeline ({stacks.length} categories)
					</a>
				</div>
			)
		}
	</div>
</section>
