---
interface Props {
	currentPage: number;
	totalPages: number;
	basePath?: string;
	totalItems?: number;
	itemsPerPage?: number;
}

const {
	currentPage,
	totalPages,
	basePath = "/blog",
	totalItems,
	itemsPerPage = 9,
} = Astro.props;

if (totalPages <= 1) {
	return null;
}

const getPageUrl = (page: number) => {
	if (page <= 1) return basePath;
	return `${basePath}/page/${page}`;
};

const prevUrl = currentPage > 1 ? getPageUrl(currentPage - 1) : null;
const nextUrl = currentPage < totalPages ? getPageUrl(currentPage + 1) : null;

const getPageNumbers = () => {
	const pages: (number | "ellipsis")[] = [];
	const maxVisible = 5;

	if (totalPages <= maxVisible + 2) {
		for (let i = 1; i <= totalPages; i++) pages.push(i);
		return pages;
	}

	pages.push(1);

	const left = Math.max(2, currentPage - 1);
	const right = Math.min(totalPages - 1, currentPage + 1);

	if (left > 2) {
		pages.push("ellipsis");
	}

	for (let i = left; i <= right; i++) {
		pages.push(i);
	}

	if (right < totalPages - 1) {
		pages.push("ellipsis");
	}

	pages.push(totalPages);
	return pages;
};

const pageNumbers = getPageNumbers();
---

<nav
	class="mt-16 flex flex-col items-center justify-between gap-4 border-t-[1.5px] border-current pt-8 sm:flex-row"
	aria-label="Pagination"
>
	{
		typeof totalItems === "number" ? (
			<p class="label-mono opacity-80">
				Showing {(currentPage - 1) * itemsPerPage + 1} to{" "}
				{Math.min(currentPage * itemsPerPage, totalItems)} of {totalItems} posts
			</p>
		) : (
			<p class="label-mono opacity-80">
				Page {currentPage} of {totalPages}
			</p>
		)
	}

	<div class="flex flex-wrap items-center gap-2">
		{
			prevUrl ? (
				<a
					href={prevUrl}
					class="key bg-cream px-3! py-2! text-xs! text-ink"
					aria-label="Go to previous page"
				>
					Previous
				</a>
			) : (
				<span
					class="key cursor-not-allowed bg-cream px-3! py-2! text-xs! text-ink opacity-40"
					aria-disabled="true"
				>
					Previous
				</span>
			)
		}

		<div class="flex items-center gap-1.5">
			{
				pageNumbers.map((p) => {
					if (p === "ellipsis") {
						return <span class="label-mono px-2 py-1 opacity-60">...</span>;
					}

					const isCurrent = p === currentPage;
					return isCurrent ? (
						<span
							class="key bg-ink px-3! py-2! text-xs! text-cream"
							aria-current="page"
						>
							{p}
						</span>
					) : (
						<a
							href={getPageUrl(p)}
							class="key bg-cream px-3! py-2! text-xs! text-ink"
							aria-label={`Go to page ${p}`}
						>
							{p}
						</a>
					);
				})
			}
		</div>

		{
			nextUrl ? (
				<a
					href={nextUrl}
					class="key bg-cream px-3! py-2! text-xs! text-ink"
					aria-label="Go to next page"
				>
					Next
				</a>
			) : (
				<span
					class="key cursor-not-allowed bg-cream px-3! py-2! text-xs! text-ink opacity-40"
					aria-disabled="true"
				>
					Next
				</span>
			)
		}
	</div>
</nav>

