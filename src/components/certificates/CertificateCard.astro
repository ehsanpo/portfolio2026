---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	name: string;
	image: ImageMetadata;
	year: string;
	index: number;
}

const { name, image, year, index } = Astro.props;
---

<article
	class="group relative flex flex-col justify-between border-r-[1.5px] border-b-[1.5px] border-ink bg-cream p-5 text-ink transition-colors hover:bg-mustard"
>
	<div class="flex items-center justify-between gap-2">
		<span class="label-mono text-ink/60">
			NO. {String(index + 1).padStart(2, "0")}
		</span>
		<span class="font-pixel border-[1.5px] border-ink bg-paper px-2 py-0.5 text-sm">
			{year}
		</span>
	</div>

	<div
		class="my-5 flex h-28 w-full items-center justify-center border-[1.5px] border-ink/20 bg-paper p-4 transition-transform duration-200 group-hover:scale-[1.03]"
	>
		<Image
			src={image}
			alt={name}
			widths={[400, 600, 800]}
			sizes="(max-width: 768px) 100vw, 25vw"
			format="webp"
			quality={80}
			loading="lazy"
			class="max-h-20 w-auto object-contain"
		/>
	</div>

	<div class="border-t-[1.5px] border-ink/20 pt-3">
		<h3 class="text-base leading-snug font-bold tracking-[-0.02em] text-ink">
			{name}
		</h3>
		<div class="mt-2 flex items-center justify-between">
			<span class="label-mono text-[10px]! text-ink/70">STATUS / VERIFIED</span>
			<span class="size-2 border border-ink bg-mint" aria-hidden="true"></span>
		</div>
	</div>
</article>


