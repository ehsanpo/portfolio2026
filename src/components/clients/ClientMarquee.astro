---
import { getPortfolioItems } from "../../utils/data";
import MarqueeContent from "./MarqueeContent.astro";

const portfolioItems = await getPortfolioItems();

const uniqueClients = [...new Set(portfolioItems.map((item) => item.client))].filter(Boolean);
---

<section class="block-cobalt border-t-[1.5px] border-ink py-12">
	<div class="container mb-8">
		<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
			<p class="label-mono">/ Shipped for</p>
			<div class="flex items-center gap-3">
				<p class="label-mono hidden opacity-70 sm:block">Selected client roster</p>
				<span class="size-2 bg-current" aria-hidden="true"></span>
			</div>
		</div>
	</div>

	<div class="relative overflow-hidden">
		<div class="marquee-container">
			<MarqueeContent clients={uniqueClients} />
			<MarqueeContent clients={uniqueClients} />
		</div>
	</div>
</section>

<style>
	.marquee-container {
		display: flex;
		width: max-content;
		animation: scroll 30s linear infinite;
		gap: 1.5rem;
	}

	@keyframes scroll {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.marquee-container:hover {
		animation-play-state: paused;
	}
</style>

