---
interface Props {
	clients: string[];
}

const { clients } = Astro.props;
---

<div class="flex shrink-0 items-center gap-6 px-3">
	{
		clients.map((client) => (
			<div class="on-paper hard bg-cream px-5 py-2.5 font-mono text-sm font-semibold whitespace-nowrap text-ink">
				{client}
			</div>
		))
	}
</div>

