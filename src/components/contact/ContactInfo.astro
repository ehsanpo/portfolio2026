---
import { getPortfolioData } from "../../utils/data";
const { contact } = getPortfolioData();
---

<div class="flex flex-col gap-5">
	<div>
		<h3 class="label-mono text-ink/70">Location</h3>
		<p class="mt-2 font-mono text-sm text-ink">{contact.location}</p>
	</div>

	<div>
		<h3 class="label-mono text-ink/70">Connect</h3>
		<div class="mt-2 flex flex-wrap gap-2">
			{
				Object.entries(contact.socialLinks).map(([platform, url]) => (
					<a
						href={url}
						target="_blank"
						rel="noopener noreferrer"
						class="key bg-paper px-2.5! py-1.5! text-[11px]! text-ink shadow-[2px_2px_0_var(--ink)]!"
					>
						{platform}
					</a>
				))
			}
		</div>
	</div>
</div>
