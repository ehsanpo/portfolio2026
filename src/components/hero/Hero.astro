---
import type React from "react";
import Island from "./Island.astro";

interface Props {
	text?: string;
	title: string;
	subtitle?: string | React.ReactNode;
	subtitleText?: string;
	children?: React.ReactNode;
	island?: boolean;
	fullHeight?: boolean;
	img?: string;
}

const { title, subtitle, text, subtitleText, fullHeight = false, img, island } = Astro.props;
---

<section
	class={`border-b-[1.5px] border-foreground bg-paper dark:bg-background pt-28 pb-12 ${fullHeight ? "md:py-20" : ""}`}
>
	<div class="container mx-auto px-4">
		<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3 mb-8">
			<p class="label-mono">/ {text || title}</p>
			<div class="flex items-center gap-3">
				<p class="label-mono hidden opacity-70 sm:block">Profile &amp; specification</p>
				<span class="size-2 bg-current" aria-hidden="true"></span>
			</div>
		</div>

		<div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12">
			<div class={img || island ? "lg:col-span-7" : "lg:col-span-12"}>
				<h1 class="text-balance text-4xl md:text-6xl font-bold tracking-[-0.04em] leading-[1.02]">
					{title}
				</h1>
				{
					subtitle && (
						<p class="mt-4 text-xl md:text-2xl font-medium leading-snug">
							{subtitle}
						</p>
					)
				}
				{
					subtitleText && (
						<p class="mt-4 max-w-xl text-lg leading-relaxed text-muted-foreground">
							{subtitleText}
						</p>
					)
				}
				<div class="mt-6">
					<slot />
				</div>
			</div>

			{
				island && (
					<div class="lg:col-span-5">
						<div class="on-paper hard bg-cream overflow-hidden p-4">
							<Island />
						</div>
					</div>
				)
			}

			{
				img && (
					<div class="lg:col-span-5">
						<div class="on-paper hard bg-cream overflow-hidden">
							<div class="flex items-center gap-3 border-b-[1.5px] border-ink px-2.5 py-1.5 bg-cream text-ink">
								<span class="size-3 shrink-0 border-[1.5px] border-ink bg-mustard" aria-hidden="true"></span>
								<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
								<span class="font-pixel text-sm leading-none">FIG. 01</span>
								<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
							</div>
							<img
								src={img}
								alt={title}
								class="w-full h-auto object-cover block"
							/>
						</div>
					</div>
				)
			}
		</div>
	</div>
</section>
