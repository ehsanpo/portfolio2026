---
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props;
const displayTitle = title.endsWith(".") ? title : `${title}.`;
---

<section class="block-mustard border-b-[1.5px] border-ink pt-28 pb-10 md:pt-32 md:pb-12">
	<div class="container mx-auto px-4">
		<div class="flex items-center justify-between border-t-[1.5px] border-ink pt-3">
			<p class="label-mono">/ Directory &amp; archive</p>
			<div class="flex items-center gap-3">
				<p class="label-mono hidden opacity-70 sm:block">{title}</p>
				<span class="size-2 bg-ink" aria-hidden="true"></span>
			</div>
		</div>

		<h1 class="mt-6 max-w-4xl text-4xl font-bold tracking-[-0.04em] text-ink md:text-6xl">
			{displayTitle}
		</h1>
		{
			subtitle && (
				<p class="mt-4 max-w-xl text-lg leading-snug text-ink/85">
					{subtitle}
				</p>
			)
		}
	</div>
</section>
