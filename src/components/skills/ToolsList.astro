---
import { getPortfolioData } from "../../utils/data";
import Card3D from "../Card3D";
const { tools } = getPortfolioData();
---

<section id="tools" class="section">
	<div class="container mx-auto px-4">
		<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
			<p class="label-mono">/ Development tools</p>
			<div class="flex items-center gap-3">
				<p class="label-mono hidden opacity-70 sm:block">{tools.length} daily drivers</p>
				<span class="size-2 bg-current" aria-hidden="true"></span>
			</div>
		</div>

		<h2 class="mt-8 max-w-3xl text-4xl md:text-5xl font-bold tracking-[-0.04em]">
			Development Tools.
		</h2>

		<div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
			{
				tools.map((tool, index) => (
					<Card3D client:load intensity={10} shine={false} className="h-full">
						<div class="flex h-full flex-col justify-between text-ink">
							<div>
								<div class="flex items-center gap-2.5 border-b-[1.5px] border-ink px-3 py-2 bg-cream">
									<span
										class="size-2.5 shrink-0 border-[1.5px] border-ink bg-cobalt"
										aria-hidden="true"
									/>
									<span class="stripes h-[11px] flex-1" aria-hidden="true" />
									<span class="font-pixel text-xs leading-none uppercase">
										TOOL / 0{index + 1}
									</span>
								</div>
								<div class="p-6">
									<div class="mb-4 flex items-center gap-3">
										<div class="flex size-10 shrink-0 items-center justify-center border-[1.5px] border-ink bg-paper p-1.5">
											<img src={tool.icon} alt={tool.name} class="size-6 object-contain" />
										</div>
										<h3 class="text-xl font-bold tracking-[-0.03em] text-ink">{tool.name}</h3>
									</div>
									<p class="text-sm leading-relaxed text-ink/80">{tool.description}</p>
								</div>
							</div>

							<div class="border-t-[1.5px] border-ink/25 bg-paper/60 px-6 py-3">
								<div class="mb-1.5 flex items-center justify-between">
									<span class="label-mono text-[10px]! text-ink/70">Proficiency</span>
									<span class="font-mono text-xs font-semibold text-ink">
										{tool.proficiency}/10
									</span>
								</div>
								<div class="h-2 w-full border border-ink/40 bg-paper">
									<div
										class="h-full bg-ink"
										style={`width: ${tool.proficiency * 10}%`}
									/>
								</div>
							</div>
						</div>
					</Card3D>
				))
			}
		</div>
	</div>
</section>
