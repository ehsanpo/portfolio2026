---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/hero/Hero.astro";
import ExperienceBlock from "@/blocks/ExperienceBlock.astro";
import Testimonials from "@/blocks/TestimonialsBlock.astro";

const principles = [
	{
		title: "Iterative Excellence",
		text: "Code and art thrive through iterative processes. I embrace trial, error, and rapid iteration to create solutions that transcend boundaries.",
	},
	{
		title: "Architects of Inclusivity",
		text: "Developers shape a virtual landscape where inclusivity and user-centric design prevail. My goal is to create online spaces where every user feels a sense of belonging.",
	},
	{
		title: "Humility in Design",
		text: "Ego has no place in design. I approach work humbly, embracing failure to pave the way for rapid success.",
	},
	{
		title: "Problem Definition",
		text: "Effective design starts with clear problem definition. Understanding challenges leads to purposeful solutions.",
	},
	{
		title: "Diverse Solutions",
		text: "No single solution fits all. I explore creative possibilities to address unique contexts and demands.",
	},
	{
		title: "User-Centric Empathy",
		text: "Guided by empathy, I design from a user-centric perspective, ensuring solutions resonate and provide value.",
	},
	{
		title: "Ethics and Impact",
		text: "I prioritize privacy, security, and ethics, contributing to a digital landscape of integrity.",
	},
];

const motivators = [
	"Tackling complex problems.",
	"Empowering colleagues to contribute meaningful insights.",
	"Constructing cohesive and scalable software architectures.",
	"Optimizing workflows. Sharing expertise.",
	"Establishing credibility and reliability.",
	"Code is not just functional; it molds digital environments, driving innovation.",
];
---

<Layout title="About">
	<Hero fullHeight title="About Me" text="About" img="/img/200925148-0.jpg">
		<div class="max-w-xl">
			<p class="mb-5 text-xl leading-snug md:text-2xl">
				I'm a passionate full-stack developer with a keen eye for design and a drive for creating
				exceptional digital experiences.
			</p>
			<p class="text-lg leading-relaxed text-muted-foreground">
				With years of experience in web development and design, I combine technical expertise with
				creative problem-solving to deliver innovative solutions.
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href="/cv" class="key bg-ink text-cream">Open the resume</a>
				<a
					href="https://www.linkedin.com/in/ehsanp/"
					target="_blank"
					rel="noopener noreferrer"
					class="key bg-cream text-ink"
				>
					Reach me on LinkedIn
				</a>
			</div>
		</div>
	</Hero>

	<ExperienceBlock />
	<Testimonials showAll />

	<section id="background" class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Background</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">Self-taught, full stack</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-12">
				<h2 class="text-4xl md:text-5xl font-bold tracking-[-0.04em] lg:col-span-5">Background.</h2>
				<div class="space-y-5 text-lg leading-relaxed lg:col-span-7">
					<p>
						My journey as a self-taught professional has equipped me with a profound understanding of
						software development, design, and multimedia. With a relentless drive for excellence, I
						have honed my expertise in delivering robust software architectures, seamless user
						experiences, and visually captivating designs. With a diverse skill set, I excel in
						various web development stacks, anchored by a robust command of WordPress and Laravel
						for backend excellence.
					</p>
					<p>
						My proficiency extends seamlessly to front-end mastery with Javascript and HTML/CSS.
						Beyond web development, I possess a profound comprehension of user interface design,
						intricacies of logo and identity creation, and the intricacies of search engine
						optimization.
					</p>
					<p>
						My extensive expertise also spans multimedia and mobile development, as I consistently
						seek novel ideas and methodologies to elevate my skills and enrich the user experience.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section id="philosophy" class="block-mustard section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Philosophy</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">{principles.length} working principles</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-8 max-w-3xl text-4xl md:text-5xl font-bold tracking-[-0.04em]">Philosophy.</h2>
			<ol class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					principles.map((p, i) => (
						<li class="on-paper hard bg-cream text-ink flex flex-col">
							<div class="flex items-center gap-2.5 border-b-[1.5px] border-ink px-3 py-2">
								<span class="size-2.5 shrink-0 border-[1.5px] border-ink bg-ink" aria-hidden="true" />
								<span class="stripes h-[11px] flex-1" aria-hidden="true" />
								<span class="font-pixel text-xs leading-none">{String(i + 1).padStart(2, "0")}</span>
							</div>
							<div class="p-5">
								<h3 class="text-xl font-bold tracking-[-0.03em]">{p.title}</h3>
								<p class="mt-3 leading-relaxed text-ink/85">{p.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="motivators" class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Motivators</p>
				<span class="size-2 bg-current" aria-hidden="true"></span>
			</div>
			<div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-12">
				<h2 class="text-4xl md:text-5xl font-bold tracking-[-0.04em] lg:col-span-5">Motivators.</h2>
				<ul class="divide-y divide-border border-y border-border lg:col-span-7">
					{
						motivators.map((m, i) => (
							<li class="grid grid-cols-[3rem_1fr] gap-4 py-4 text-lg leading-snug">
								<span class="label-mono pt-1.5 text-muted-foreground">
									{String(i + 1).padStart(2, "0")}
								</span>
								<span class="font-medium">{m}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section id="tea" class="block-mint section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Off the clock: tea</p>
				<span class="size-2 bg-current" aria-hidden="true"></span>
			</div>
			<div class="mt-8 grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
				<div class="lg:col-span-5">
					<div class="on-paper hard bg-cream overflow-hidden">
						<img src="/img/tea.png" alt="Time for Tea" class="block w-full h-auto" />
					</div>
				</div>
				<div class="lg:col-span-7">
					<h2 class="text-4xl md:text-5xl font-bold tracking-[-0.04em]">It's Always Time for Tea.</h2>
					<p class="mt-5 max-w-xl text-lg leading-relaxed">
						"It's always time for tea" reflects the value of creating space for connection and
						thoughtful collaboration. In tech, it serves as a reminder to pause, reflect, and engage
						with others meaningfully. This mindset fosters creativity, inclusivity, and innovative
						problem-solving, demonstrating that the best ideas emerge when teams feel supported and
						empowered to share their perspectives.
					</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
