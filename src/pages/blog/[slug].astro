---
import Layout from "../../layouts/Layout.astro";
import { TableOfContents, type TocHeading } from "../../components/blog/TableOfContents";
import { getBlogPosts } from "../../utils/data";

export async function getStaticPaths() {
	const blogPosts = await getBlogPosts();
	return blogPosts.map((post, index) => ({
		params: { slug: post.slug },
		props: {
			post,
			newerPost: index > 0 ? blogPosts[index - 1] : null,
			olderPost: index < blogPosts.length - 1 ? blogPosts[index + 1] : null,
		},
	}));
}

interface BlogPost {
	title: string;
	description?: string;
	date: string;
	author?: string;
	category?: string[];
	tag?: string[];
	cover?: {
		height: number;
		width: number;
		src: string;
	};
	featured?: boolean;
	content: any;
	slug: string;
}

interface PageProps {
	post: BlogPost;
	newerPost: BlogPost | null;
	olderPost: BlogPost | null;
}

const { post, newerPost, olderPost } = Astro.props as unknown as PageProps;
const { Content, headings } = await post.content.render();

const rawBody: string = typeof post.content?.body === "string" ? post.content.body : "";
const wordCount = rawBody.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));

const primaryHeadings: TocHeading[] = (headings as TocHeading[]).filter(
	(h) => h.depth >= 2 && h.depth <= 3
);
const tocHeadings: TocHeading[] =
	primaryHeadings.length > 0
		? primaryHeadings
		: (headings as TocHeading[]).filter((h) => h.depth >= 1 && h.depth <= 4);

const hasToc = tocHeadings.length > 0;

const formatDate = (dateString: string) => {
	return new Date(dateString).toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
};

const sanitize = (text: string) => text.replace(/\s*[—–]\s*/g, ", ");
---

<Layout
	title={`${sanitize(post.title)} - Blog`}
	description={post.description
		? sanitize(post.description)
		: `Read ${sanitize(post.title)} on Ehsan's Blog`}
	image={post.cover?.src || "/img/ogdefault.jpg"}
	imageAlt={sanitize(post.title)}
>
	<div
		id="blog-reading-progress"
		class="fixed inset-x-0 top-0 z-[55] h-1 origin-left scale-x-0 bg-tomato transition-transform duration-75 motion-reduce:transition-none"
		aria-hidden="true"
	>
	</div>

	<article class="min-h-screen overflow-x-clip bg-background pb-16 text-foreground">
		<header>
			<div
				class:list={[
					"block-mustard border-b-[1.5px] border-ink",
					post.cover ? "pt-28 pb-40 md:pt-36 md:pb-56" : "pt-28 pb-12 md:pt-36 md:pb-16",
				]}
			>
				<div class="container">
					<div class="mx-auto max-w-4xl">
						<a
							href="/blog"
							class="label-mono inline-flex min-h-[44px] items-center gap-2 text-ink underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="size-3.5"
								aria-hidden="true"
							>
								<path d="m12 19-7-7 7-7"></path>
								<path d="M19 12H5"></path>
							</svg>
							All posts
						</a>

						<h1 class="mt-4 text-4xl leading-none font-bold tracking-[-0.04em] text-ink sm:text-5xl md:text-7xl">
							{sanitize(post.title)}
						</h1>

						{
							post.description && (
								<p class="mt-5 max-w-2xl text-lg leading-snug text-ink/85">
									{sanitize(post.description)}
								</p>
							)
						}

						<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-ink">
							{
								post.author && (
									<div class="flex items-center gap-2.5">
										<span
											class="flex size-7 items-center justify-center border-[1.5px] border-ink bg-cream font-mono text-xs font-bold text-ink"
											aria-hidden="true"
										>
											{post.author.slice(0, 2).toUpperCase()}
										</span>
										<span class="font-mono text-sm font-medium">{post.author}</span>
									</div>
								)
							}
							<p class="label-mono">
								<time datetime={post.date}>{formatDate(post.date)}</time>
							</p>
							<p class="label-mono">{readingMinutes} min read</p>
							{
								post.category && post.category.length > 0 && (
									<div class="flex flex-wrap gap-2">
										{post.category.map((cat) => (
											<span class="label-mono border-[1.5px] border-ink bg-cream px-2.5 py-1 text-ink">
												{cat}
											</span>
										))}
									</div>
								)
							}
						</div>
					</div>
				</div>
			</div>

			{
				post.cover && (
					<div class="container -mt-28 md:-mt-44">
						<div class="hard mx-auto max-w-4xl bg-cream p-1.5">
							<img
								src={post.cover.src}
								alt={sanitize(post.title)}
								class="max-h-[28rem] w-full object-cover"
							/>
						</div>
					</div>
				)
			}
		</header>

		<div class="container mt-12 md:mt-16">
			<div
				class:list={[
					"mx-auto",
					hasToc
						? "grid max-w-[96rem] grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-12"
						: "max-w-2xl",
				]}
			>
				<div class:list={["min-w-0", hasToc ? "mx-auto w-full max-w-2xl lg:mx-0" : "w-full"]}>
					{hasToc && <TableOfContents headings={tocHeadings} variant="mobile" client:load />}

					<div
						data-post-body="true"
						class="post-prose prose prose-base md:prose-lg dark:prose-invert max-w-none prose-headings:scroll-mt-24 prose-headings:font-bold prose-headings:tracking-[-0.03em] prose-a:decoration-brand prose-a:underline-offset-4 prose-pre:rounded-none prose-pre:border-[1.5px] prose-pre:border-foreground prose-img:rounded-none prose-img:border-[1.5px] prose-img:border-foreground"
					>
						<Content />
					</div>

					{
						post.tag && post.tag.length > 0 && (
							<div class="mt-12 border-t-[1.5px] border-foreground pt-6">
								<div class="flex flex-wrap items-center gap-2">
									<span class="label-mono mr-1 opacity-75">Tags:</span>
									{post.tag.map((tag) => (
										<span class="border-[1.5px] border-foreground bg-card px-2.5 py-1 font-mono text-xs font-medium text-foreground">
											#{tag}
										</span>
									))}
								</div>
							</div>
						)
					}

					<footer class="mt-12">
						<div class="flex flex-wrap items-center justify-between gap-4 border-y-[1.5px] border-foreground py-4">
							<div class="flex items-center gap-2.5">
								{
									post.author && (
										<span class="font-mono text-sm font-medium">{post.author}</span>
									)
								}
								<span class="label-mono opacity-70">
									<time datetime={post.date}>{formatDate(post.date)}</time>
								</span>
							</div>
							<a
								href="/blog"
								class="label-mono underline underline-offset-4 hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
							>
								All posts
							</a>
						</div>

						{
							(newerPost || olderPost) && (
								<nav
									class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2"
									aria-label="More posts"
								>
									{newerPost && (
										<a
											href={`/blog/${newerPost.slug}`}
											class="group border-[1.5px] border-foreground bg-card p-4 transition-colors hover:bg-mustard hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
										>
											<span class="label-mono flex items-center gap-2">
												<svg
													xmlns="http://www.w3.org/2000/svg"
													width="14"
													height="14"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
													class="size-3.5"
													aria-hidden="true"
												>
													<path d="m12 19-7-7 7-7" />
													<path d="M19 12H5" />
												</svg>
												Newer
											</span>
											<span class="mt-2 block text-lg font-bold tracking-tight">
												{sanitize(newerPost.title)}
											</span>
										</a>
									)}

									{olderPost && (
										<a
											href={`/blog/${olderPost.slug}`}
											class:list={[
												"group border-[1.5px] border-foreground bg-card p-4 text-right transition-colors hover:bg-mustard hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
												!newerPost && "sm:col-start-2",
											]}
										>
											<span class="label-mono flex items-center justify-end gap-2">
												Older
												<svg
													xmlns="http://www.w3.org/2000/svg"
													width="14"
													height="14"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
													class="size-3.5"
													aria-hidden="true"
												>
													<path d="M5 12h14" />
													<path d="m12 5 7 7-7 7" />
												</svg>
											</span>
											<span class="mt-2 block text-lg font-bold tracking-tight">
												{sanitize(olderPost.title)}
											</span>
										</a>
									)}
								</nav>
							)
						}
					</footer>
				</div>

				{
					hasToc && (
						<aside class="sticky top-28 hidden lg:block">
							<TableOfContents headings={tocHeadings} variant="desktop" client:load />
						</aside>
					)
				}
			</div>
		</div>
	</article>
</Layout>

<script>
	function initBlogReadingProgress() {
		const bar = document.getElementById("blog-reading-progress");
		const body = document.querySelector<HTMLElement>('[data-post-body="true"]');
		if (!bar || !body) return;

		const update = () => {
			const rect = body.getBoundingClientRect();
			const total = body.offsetHeight - window.innerHeight * 0.6;
			const progressed = Math.max(0, -rect.top + window.innerHeight * 0.25);
			const ratio = total > 0 ? Math.min(1, progressed / total) : 1;
			bar.style.transform = `scaleX(${ratio.toFixed(4)})`;
		};

		update();
		window.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update, { passive: true });

		document.addEventListener(
			"astro:before-swap",
			() => {
				window.removeEventListener("scroll", update);
				window.removeEventListener("resize", update);
			},
			{ once: true }
		);
	}

	document.addEventListener("astro:page-load", initBlogReadingProgress);
</script>
