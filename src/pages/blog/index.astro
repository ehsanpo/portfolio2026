---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/hero/PageHero.astro";
import { getBlogPosts } from "../../utils/data";
import { BlogCard } from "../../components/blog/BlogCard";
import Pagination from "../../components/blog/Pagination.astro";

const POSTS_PER_PAGE = 9;

const blogPosts = await getBlogPosts();
const featuredPosts = blogPosts.filter((post) => post.featured === true).slice(0, 4);
const regularPosts = blogPosts.filter((post) => post.featured !== true);

const totalPages = Math.max(1, Math.ceil(regularPosts.length / POSTS_PER_PAGE));
const currentPage = 1;
const paginatedRegularPosts = regularPosts.slice(0, POSTS_PER_PAGE);
---

<Layout
	title="Blog - Thoughts and Insights"
	description="Thoughts, insights, and stories from my journey as a developer"
	image="/img/ogdefault.jpg"
	imageAlt="Ehsan's Blog - Developer Insights and Stories"
>
	<PageHero
		title="Blog & field notes"
		subtitle="Thoughts, insights, and stories from my journey as a developer."
	/>
	<section class="section">
		<div class="container mx-auto px-4">
			{
				featuredPosts.length > 0 && (
					<div class="mb-20">
						<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
							<p class="label-mono">/ Featured dispatches</p>
							<div class="flex items-center gap-3">
								<p class="label-mono hidden opacity-70 sm:block">
									{featuredPosts.length} selected notes
								</p>
								<span class="size-2 bg-current" aria-hidden="true" />
							</div>
						</div>
						<h2 class="mt-6 mb-10 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
							Featured dispatches.
						</h2>
						<div class="grid grid-cols-1 gap-8 md:grid-cols-2">
							{featuredPosts.map((post) => (
								<BlogCard post={post} featured={true} client:load />
							))}
						</div>
					</div>
				)
			}

			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ All dispatches</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">{regularPosts.length} articles</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-6 mb-10 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
				{featuredPosts.length > 0 ? "All articles." : "Latest articles."}
			</h2>

			<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
				{paginatedRegularPosts.map((post) => <BlogCard post={post} client:load />)}
			</div>

			<Pagination
				currentPage={currentPage}
				totalPages={totalPages}
				totalItems={regularPosts.length}
				itemsPerPage={POSTS_PER_PAGE}
				basePath="/blog"
			/>

			{
				blogPosts.length === 0 && (
					<div class="on-paper hard mt-12 bg-cream p-12 text-center text-ink">
						<h3 class="mb-2 text-2xl font-bold tracking-[-0.03em]">No blog posts yet</h3>
						<p class="text-sm opacity-80">Stay tuned for upcoming articles and insights.</p>
					</div>
				)
			}
		</div>
	</section>
</Layout>

