---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/hero/PageHero.astro";
import ContactInfo from "@/components/contact/ContactInfo.astro";
import { DrawerDemo } from "@/components/drawer";
import GuestbookContainer from "@/components/guestbook/GuestbookContainer";
---

<Layout title="Contact">
	<PageHero
		title="Get in Touch"
		subtitle="Have a project in mind? Let's discuss how we can work together."
	/>

	<section id="hello" class="block-cobalt section border-b-[1.5px] border-ink">
		<div class="container">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Studio line</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">Replies within a few days</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>

			<div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-12">
				<div class="lg:col-span-5">
					<h2>Got something odd to build?</h2>
					<p class="mt-5 max-w-sm text-lg leading-snug">
						Send a message, or find me on Discord or LinkedIn. Whichever you check first.
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a
							href="https://discord.com/users/ehsanpo"
							target="_blank"
							rel="noopener noreferrer"
							class="key bg-cream text-ink"
						>
							<svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" aria-hidden="true">
								<path
									d="M39.248,10.177c-2.804-1.287-5.812-2.235-8.956-2.778c-0.057-0.01-0.114,0.016-0.144,0.068c-0.387,0.688-0.815,1.585-1.115,2.291c-3.382-0.506-6.747-0.506-10.059,0c-0.3-0.721-0.744-1.603-1.133-2.291c-0.03-0.051-0.087-0.077-0.144-0.068c-3.143,0.541-6.15,1.489-8.956,2.778c-0.024,0.01-0.045,0.028-0.059,0.051c-5.704,8.522-7.267,16.835-6.5,25.044c0.003,0.04,0.026,0.079,0.057,0.103c3.763,2.764,7.409,4.442,10.987,5.554c0.057,0.017,0.118-0.003,0.154-0.051c0.846-1.156,1.601-2.374,2.248-3.656c0.038-0.075,0.002-0.164-0.076-0.194c-1.197-0.454-2.336-1.007-3.432-1.636c-0.087-0.051-0.094-0.175-0.014-0.234c0.231-0.173,0.461-0.353,0.682-0.534c0.04-0.033,0.095-0.04,0.142-0.019c7.201,3.288,14.997,3.288,22.113,0c0.047-0.023,0.102-0.016,0.144,0.017c0.22,0.182,0.451,0.363,0.683,0.536c0.08,0.059,0.075,0.183-0.012,0.234c-1.096,0.641-2.236,1.182-3.434,1.634c-0.078,0.03-0.113,0.12-0.075,0.196c0.661,1.28,1.415,2.498,2.246,3.654c0.035,0.049,0.097,0.07,0.154,0.052c3.595-1.112,7.241-2.79,11.004-5.554c0.033-0.024,0.054-0.061,0.057-0.101c0.917-9.491-1.537-17.735-6.505-25.044C39.293,10.205,39.272,10.187,39.248,10.177z M16.703,30.273c-2.168,0-3.954-1.99-3.954-4.435s1.752-4.435,3.954-4.435c2.22,0,3.989,2.008,3.954,4.435C20.658,28.282,18.906,30.273,16.703,30.273z M31.324,30.273c-2.168,0-3.954-1.99-3.954-4.435s1.752-4.435,3.954-4.435c2.22,0,3.989,2.008,3.954,4.435C35.278,28.282,33.544,30.273,31.324,30.273z"
									fill="currentColor"></path>
							</svg>
							Discord
						</a>
						<a
							href="https://www.linkedin.com/in/ehsanp/"
							target="_blank"
							rel="noopener noreferrer"
							class="key bg-cream text-ink"
						>
							<svg class="size-4" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path
									fill="currentColor"
									d="M92.86,0H7.12A7.17,7.17,0,0,0,0,7.21V92.79A7.17,7.17,0,0,0,7.12,100H92.86A7.19,7.19,0,0,0,100,92.79V7.21A7.19,7.19,0,0,0,92.86,0ZM30.22,85.71H15.4V38H30.25V85.71ZM22.81,31.47a8.59,8.59,0,1,1,8.6-8.59A8.6,8.6,0,0,1,22.81,31.47Zm63,54.24H71V62.5c0-5.54-.11-12.66-7.7-12.66s-8.91,6-8.91,12.26V85.71H39.53V38H53.75v6.52H54c2-3.75,6.83-7.7,14-7.7,15,0,17.79,9.89,17.79,22.74Z"
								></path>
							</svg>
							LinkedIn
						</a>
					</div>
				</div>

				<div class="lg:col-span-7">
					<div class="on-paper hard bg-cream text-ink">
						<div class="flex items-center gap-3 border-b-[1.5px] border-ink px-2 py-1.5">
							<span class="size-3 shrink-0 border-[1.5px] border-ink" aria-hidden="true"></span>
							<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
							<span class="font-pixel text-sm leading-none">NEW MESSAGE / STUDIO LINE</span>
							<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
						</div>
						<div class="grid gap-6 p-5 md:grid-cols-2 md:p-6">
							<div class="flex flex-col gap-4">
								<p class="label-mono text-ink/70">Write</p>
								<div><DrawerDemo client:load /></div>
							</div>
							<ContactInfo />
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Guestbook</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">Leave a line</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-8 max-w-3xl">Guestbook.</h2>
			<div class="mt-8">
				<GuestbookContainer client:load />
			</div>
		</div>
	</section>
</Layout>
