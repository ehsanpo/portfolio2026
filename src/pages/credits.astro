---
import PageHero from "@/components/hero/PageHero.astro";
import Layout from "../layouts/Layout.astro";
import { getPortfolioData } from "../utils/data";
import Card3D from "@/components/Card3D";

const { meta } = getPortfolioData();

const categories = [
	{
		title: "Core stack",
		rule: "The frame",
		items: [
			{ name: "Astro", note: "Static site generation framework", href: "https://astro.build/", cta: "Visit astro.build" },
			{ name: "React", note: "Interactive components", href: "https://react.dev/", cta: "Visit react.dev" },
			{ name: "TailwindCSS", note: "Utility-first CSS framework", href: "https://tailwindcss.com/", cta: "Visit tailwindcss.com" },
		],
	},
	{
		title: "State and animation",
		rule: "The movement",
		items: [
			{ name: "Zustand", note: "State management", href: "https://zustand-demo.pmnd.rs/", cta: "Inspect Zustand" },
			{ name: "GSAP", note: "Professional animations", href: "https://gsap.com/", cta: "Inspect GSAP" },
			{ name: "Framer Motion", note: "React animations", href: "https://www.framer.com/motion/", cta: "Inspect Framer Motion" },
			{ name: "PhotoSwipe", note: "Gallery lightbox", href: "https://photoswipe.com/", cta: "Inspect PhotoSwipe" },
		],
	},
	{
		title: "UI components",
		rule: "The parts",
		items: [
			{ name: "Class Variance Authority", note: "Component variant management", href: "https://cva.style/docs", cta: "Read the CVA docs" },
			{ name: "TypeScript", note: "Type-safe development", href: "https://www.typescriptlang.org/", cta: "Visit typescriptlang.org" },
		],
	},
	{
		title: "Creative assets and design tools",
		rule: "The look",
		items: [
			{ name: "Adobe Photoshop", note: "Professional image editing and digital art", href: "https://www.adobe.com/products/photoshop.html", cta: "Visit adobe.com" },
			{ name: "Figma", note: "Collaborative interface design and prototyping", href: "https://www.figma.com/", cta: "Visit figma.com" },
			{ name: "Duck sprite animation", note: "Duck sprite sheet bringing life to the footer", href: "https://caz-creates-games.itch.io/", cta: "Visit the itch.io page" },
		],
	},
	{
		title: "Development tools",
		rule: "The workbench",
		items: [
			{ name: "IntelliJ IDEA", note: "Powerful IDE for intelligent development", href: "https://www.jetbrains.com/idea/", cta: "Visit jetbrains.com" },
			{ name: "Visual Studio Code", note: "Lightweight yet powerful code editor", href: "https://code.visualstudio.com/", cta: "Visit code.visualstudio.com" },
			{ name: "Antigravity", note: "Advanced AI coding assistant", href: "https://antigravity.google/", cta: "Visit antigravity.google" },
		],
	},
	{
		title: "AI assistance",
		rule: "The co-pilots",
		items: [
			{ name: "GitHub Copilot", note: "AI-powered coding assistance", href: "https://github.com/features/copilot", cta: "Visit github.com" },
			{ name: "Google Gemini", note: "Image generation and creative support", href: "https://gemini.google.com/", cta: "Visit gemini.google.com" },
		],
	},
];

const tints = ["block-mustard", "block-mint", "block-cobalt", "block-blush", "block-tomato", "block-mustard"];
---

<Layout title={`Credits - ${meta.author}`}>
	<PageHero
		title="Credits"
		subtitle="This website exists thanks to open-source tools, creative assets, and AI assistance."
	/>

	<section class="section">
		<div class="container">
			<div class="space-y-16">
				{
					categories.map((category, ci) => (
						<div>
							<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
								<p class="label-mono">/ {category.title}</p>
								<div class="flex items-center gap-3">
									<p class="label-mono hidden opacity-70 sm:block">{category.rule}</p>
									<span class="size-2 bg-current" aria-hidden="true" />
								</div>
							</div>
							<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
								{category.items.map((item, ii) => (
									<Card3D client:visible className="h-full">
										<div class="flex h-full flex-col" style="transform-style: preserve-3d;">
											<div class="flex items-center justify-between gap-3 border-b-[1.5px] border-ink px-4 py-2">
												<span class="label-mono text-ink/70">
													NO. {String(ci + 1)}.{String(ii + 1)}
												</span>
												<span class={`size-3 border-[1.5px] border-ink ${tints[ci % tints.length]}`} aria-hidden="true" />
											</div>
											<div
												class="flex flex-1 flex-col justify-between gap-5 p-5"
												style="transform: translateZ(calc(var(--hover, 0) * 20px));"
											>
												<div>
													<h3 class="text-xl font-bold tracking-[-0.03em] text-ink">{item.name}</h3>
													<p class="mt-2 text-sm leading-relaxed text-ink/80">{item.note}</p>
												</div>
												<a
													href={item.href}
													target="_blank"
													rel="noopener noreferrer"
													class="label-mono self-start text-ink underline underline-offset-4 hover:bg-mustard"
												>
													{item.cta}
												</a>
											</div>
										</div>
									</Card3D>
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="block-mustard section border-t-[1.5px] border-ink">
		<div class="container">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Thanks</p>
				<span class="size-2 bg-current" aria-hidden="true"></span>
			</div>
			<h2 class="mt-8 max-w-3xl">Thank you.</h2>
			<p class="mt-5 max-w-xl text-lg leading-snug">
				Grateful for the open-source community and every creator whose work made this site possible.
			</p>
			<a href="/" class="key mt-8 bg-ink text-cream">Back to the home page</a>
		</div>
	</section>
</Layout>
