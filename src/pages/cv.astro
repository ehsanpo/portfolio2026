---
import Resume from "@/components/Resume";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="CV" description="My CV">
	<Resume client:idle />
</Layout>

<style is:global>
	:root {
		--main-color: #d4411f;
	}

	@media print {
		@page {
			size: A4;
			margin: 16px 16px;
		}
		header,
		nav,
		#pixelworld,
		footer {
			display: none !important;
		}
		body::after {
			display: none !important;
		}
		.bg-white {
			background-color: #fff !important;
		}
		aside {
			page-break-inside: avoid;
			order: 2;
			margin-top: 16px;
		}
		.timeline-item {
			page-break-inside: avoid;
		}
	}
</style>
