---

<Layout title="Music - Developer Portfolio">
	<PageHero title="Music" subtitle="Tracks I made and mastered, plus every release on Spotify." />

	<section class="section">
		<div class="container">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Studio booth</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">{musicFiles.length} tracks on the deck</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<div class="mt-8">
				<LocalMusicPlayer client:only="react" tracks={musicFiles} />
			</div>
		</div>
	</section>

	<section class="section block-ink">
		<div class="container">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Archive playlists</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">{playlists.length} releases on Spotify</p>
					<span class="size-2 bg-mustard" aria-hidden="true"></span>
				</div>
			</div>
			<div class="mt-8 grid gap-6 md:grid-cols-3">
				{playlists.map((playlist) => <SpotifyEmbed {...playlist} client:visible />)}
			</div>
		</div>
	</section>
</Layout>
