---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/hero/PageHero.astro";
import { getPortfolioItems } from "../../utils/data";
import PortfolioFilter from "@/components/PortfolioFilter";
import { ProjectCard3D } from "@/components/ProjectCard3D";
import { getProjectImage } from "@/utils/projectHelpers";

const portfolioItems = await getPortfolioItems();
const sortedItems = portfolioItems.sort((a, b) => {
	return Number(b.port_date) - Number(a.port_date);
});

const allCategories = [...new Set(portfolioItems.flatMap((entry) => entry.category || []))].filter(
	(c): c is string => !!c
);
---

<Layout
	title="Portfolio - Work"
	description="Selected engineering, product, and creative works"
	image="/img/ogdefault.jpg"
	imageAlt="Ehsan's Portfolio - Selected Works and Projects"
>
	<PageHero title="Portfolio" subtitle="Selected engineering, product, and creative works." />
	<section class="section">
		<div class="container mx-auto px-4">
			<div class="mb-8 flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Project archive</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">{sortedItems.length} entries</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>

			<PortfolioFilter categories={allCategories} category="all" client:load />

			<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
				{
					sortedItems.map((item, index) => (
						<div data-categories={JSON.stringify(item.category || [])} class="h-full">
							<ProjectCard3D
								title={item.title || ""}
								description={item.tagline || ""}
								date={item.port_date}
								categories={item.category}
								tags={item.tag}
								image={getProjectImage(item)}
								href={`/portfolio/${item.permalink || item.slug}`}
								layout={index}
								className="h-full"
								client:load
							/>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Layout>
