---
import Layout from "@/layouts/Layout.astro";
import PortfolioHeader from "@/components/portfolio/PortfolioHeader";
import Gallery from "@/components/portfolio/Gallery.astro";
import { getProductItems } from "@/utils/data";

export async function getStaticPaths() {
	const productItems = await getProductItems();
	return productItems.map((item) => ({
		params: { slug: item.permalink },
		props: { item },
	}));
}

interface ProductItem {
	title: string;
	description?: string;
	tagline: string;
	client: string;
	agency: string;
	category: string[];
	tag: string[];
	logo: {
		height: number;
		width: number;
		src: string;
	};
	logo2?: {
		height: number;
		width: number;
		src: string;
	};
	background_image: {
		height: number;
		width: number;
		src: string;
	};
	permalink: string;
	images: {
		height: number;
		width: number;
		src: string;
	}[];
	case_link_url?: string;
	content: any;
	date: string;
}

const { item } = Astro.props as unknown as { item: ProductItem };
const { Content } = await item.content.render();
---

<Layout
	title={`${item.title} - Products`}
	description={item.description || item.tagline || `${item.title} (${item.client})`}
	image={item.background_image?.src || item.logo?.src || "/img/ogdefault.jpg"}
	imageAlt={`${item.title} (${item.client})`}
>
	<article class="bg-background text-foreground relative min-h-screen">
		<PortfolioHeader
			item={item}
			backHref="/products"
			backLabel="Back to products"
			client:load
		/>

		<div class="container mx-auto px-4 py-16">
			<div
				class={[
					"disibalist",
					"0perator",
					"chef",
				].includes(item.permalink)
					? "not-prose mx-auto mb-16 max-w-6xl"
					: "prose dark:prose-invert post-prose prose-headings:font-bold prose-headings:tracking-[-0.035em] prose-a:decoration-brand prose-a:underline-offset-4 prose-pre:rounded-none prose-pre:border-[1.5px] prose-pre:border-ink prose-img:rounded-none prose-img:border-[1.5px] prose-img:border-ink mx-auto mb-16 max-w-3xl"}
			>
				<slot />
				<Content />
			</div>

			<Gallery images={item.images} alt={item.title} />

			{
				item.case_link_url && (
					<div class="pt-6 pb-16 text-center">
						<a
							href={item.case_link_url}
							target="_blank"
							rel="noopener noreferrer"
							class="key bg-ink text-cream"
						>
							Launch live project
						</a>
					</div>
				)
			}
		</div>
	</article>
</Layout>
