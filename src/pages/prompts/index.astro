---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/hero/PageHero.astro";
import { getPrompts } from "../../utils/data";
import { Card3D } from "../../components/Card3D";

const prompts = await getPrompts();
const categories = [...new Set(prompts.map((p) => p.category).filter(Boolean))];
---

<Layout
	title="AI Prompts - Collection"
	description="A collection of AI prompts for various tasks and projects"
	image="/img/ogdefault.jpg"
	imageAlt="Ehsan's AI Prompts Collection"
>
	<PageHero
		title="Prompt library"
		subtitle="A curated collection of structured AI prompts for engineering, architecture, and product workflows."
	/>
	<section class="section">
		<div class="container mx-auto px-4">
			{
				categories.map((category) => {
					const categoryPrompts = prompts.filter((p) => p.category === category);
					return (
						<div class="mb-20 last:mb-0">
							<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
								<p class="label-mono">/ Prompt library / {category}</p>
								<div class="flex items-center gap-3">
									<p class="label-mono hidden opacity-70 sm:block">
										{categoryPrompts.length} prompts
									</p>
									<span class="size-2 bg-current" aria-hidden="true" />
								</div>
							</div>
							<h2 class="mt-6 mb-10 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
								{category}.
							</h2>
							<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
								{categoryPrompts.map((prompt) => (
									<Card3D client:load intensity={10} shine={false} className="h-[400px]">
										<div
											class="preserve-3d flex h-full flex-col items-start p-6 text-ink"
											style="transform-style: preserve-3d;"
										>
											<div
												class="mb-5 flex h-44 w-full items-center justify-center overflow-hidden border-[1.5px] border-ink bg-paper"
												style="transform: translateZ(30px);"
											>
												{prompt.image ? (
													<img
														src={prompt.image}
														alt={prompt.title}
														class="h-full w-full object-cover transition-transform duration-300 group-hover/card:scale-105"
													/>
												) : (
													<span class="font-pixel text-2xl tracking-wider text-ink">
														PROMPT
													</span>
												)}
											</div>

											<div class="preserve-3d flex flex-1 flex-col gap-2">
												<h3
													class="text-2xl leading-tight font-bold tracking-[-0.03em] text-ink"
													style="transform: translateZ(50px);"
												>
													{prompt.title}
												</h3>
												<p
													class="line-clamp-3 text-sm leading-relaxed text-ink/80"
													
												>
													{prompt.description}
												</p>
											</div>

											<div
												class="mt-auto flex w-full items-center justify-between border-t-[1.5px] border-ink/20 pt-4"
												style="transform: translateZ(40px);"
											>
												<div class="flex flex-wrap gap-1.5">
													{prompt.tags?.slice(0, 2).map((tag) => (
														<span class="border border-ink bg-paper px-2 py-0.5 font-mono text-[10px] font-semibold text-ink uppercase">
															#{tag}
														</span>
													))}
												</div>

												<span class="label-mono text-[10px]! text-ink">
													Inspect &rarr;
												</span>
											</div>

											<a
												href={`/prompts/${prompt.slug}`}
												class="absolute inset-0 z-30"
												aria-label={`View ${prompt.title}`}
											/>
										</div>
									</Card3D>
								))}
							</div>
						</div>
					);
				})
			}
		</div>
	</section>
</Layout>

