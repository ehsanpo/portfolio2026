---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/hero/PageHero.astro";
import { ProjectCard3D } from "@/components/ProjectCard3D";
import { getRoles } from "@/utils/data";
import { getRoleImage } from "@/utils/roleImageMap";

const roles = getRoles();
---

<Layout title="Professional Roles - Ehsan Pourhadi">
	<PageHero
		title="Capabilities & roles"
		subtitle="Throughout my career, I have adapted across engineering leadership, product development, cloud architecture, and creative audio production. Explore the roles where I add value."
	/>

	<section class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Capabilities &amp; roles</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">{roles.length} specializations</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>

			<div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
				{
					roles.map((role, index) => {
						const mappedImage = role.image ? getRoleImage(role.image) : undefined;
						const displayImage = mappedImage && {
							src: mappedImage.src,
							alt: role.title,
							width: mappedImage.width,
							height: mappedImage.height,
						};
						return (
							<a href={`/roles/${role.slug}`} class="block h-full cursor-pointer">
								<ProjectCard3D
									client:load
									title={role.title}
									description={role.description}
									image={displayImage}
									tags={role.tags}
									layout={index}
									className="h-full"
								/>
							</a>
						);
					})
				}
			</div>

			<div class="block-cobalt hard mt-16 p-8 text-ink md:p-12">
				<div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
					<div class="max-w-2xl">
						<p class="label-mono">/ Next chapter</p>
						<h3 class="mt-3 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
							Got a team or product to build?
						</h3>
						<p class="mt-3 text-lg leading-snug opacity-90">
							Whether you need hands-on full-stack architecture, engineering leadership, or
							end-to-end product execution, let's talk.
						</p>
					</div>
					<a href="/contact" class="key shrink-0 bg-ink text-cream">
						Call the studio
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

