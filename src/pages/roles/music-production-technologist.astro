---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/hero/Hero.astro";
import StackCard from "@/components/StackCard";
import SkillChart from "@/components/SkillChart";
import { getPortfolioData, getRoles } from "@/utils/data";
import { getRoleImage } from "@/utils/roleImageMap";

const { stacks } = getPortfolioData();
const roles = getRoles();
const currentRole = roles.find((role) => role.slug === "music-production-technologist");
const mappedImage = currentRole?.image ? getRoleImage(currentRole.image) : undefined;
const displayImage = mappedImage && {
	src: mappedImage.src,
	alt: currentRole?.title,
	width: mappedImage.width,
	height: mappedImage.height,
};

const musicStacks = stacks.filter((stack) =>
	["Multimedia", "Front-end", "Design"].includes(stack.slug)
);

const musicChart = {
	slug: "Music Production Skills",
	labels: [
		"Audio Production",
		"Sound Design",
		"Music Tech",
		"Creative Direction",
		"Event Planning",
		"Technical Integration",
	],
	data: ["10", "9", "10", "8", "8", "9"],
};

const musicTools = [
	{
		name: "Reason Studios",
		icon: "/img/timeline-icons/reason-studios.svg",
		description: "Professional DAW for music production, mixing, and sound design",
		proficiency: 10,
	},
	{
		name: "Cubase",
		icon: "/img/timeline-icons/cubase.svg",
		description: "Advanced digital audio workstation for recording and production",
		proficiency: 9,
	},
	{
		name: "FFmpeg",
		icon: "/img/timeline-icons/ffmpeg.svg",
		description: "Audio/video processing and conversion for multimedia projects",
		proficiency: 7,
	},
	{
		name: "After Effects",
		icon: "/img/timeline-icons/after-effects.svg",
		description: "Motion graphics and visual effects for music videos",
		proficiency: 5,
	},
];
---

<Layout title="Music Production Technologist - Ehsan Pourhadi">
	<Hero fullHeight title="Music Production Technologist" img={displayImage?.src}>
		<div class="space-y-4">
			<p class="text-xl font-medium leading-snug">
				{currentRole?.description}
			</p>
			<p class="text-base leading-relaxed opacity-85">
				I merge technical precision with creative expression, producing music that resonates
				emotionally while leveraging modern audio technology. From beat creation to mastering, I
				craft sonic experiences that tell stories.
			</p>
		</div>
	</Hero>

	<section class="section">
		<div class="container mx-auto px-4">
			<div class="mx-auto max-w-5xl space-y-20">
				<div>
					<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
						<p class="label-mono">/ What I bring</p>
						<div class="flex items-center gap-3">
							<p class="label-mono hidden opacity-70 sm:block">Audio &amp; engineering</p>
							<span class="size-2 bg-current" aria-hidden="true"></span>
						</div>
					</div>
					<h2 class="mt-6 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
						Studio production &amp; audio technology.
					</h2>
					<p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted-foreground">
						I merge technical expertise with creative vision to produce professional-quality music
						and multimedia experiences. With formal training in music production and 15+ years of
						hands-on experience, I understand both the artistic and technical aspects of sound
						design, from beat creation to mastering, and from live events to digital distribution.
					</p>
				</div>

				<div>
					<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
						<p class="label-mono">/ Evidence</p>
						<div class="flex items-center gap-3">
							<p class="label-mono hidden opacity-70 sm:block">On the record</p>
							<span class="size-2 bg-current" aria-hidden="true"></span>
						</div>
					</div>
					<h2 class="mt-6 mb-8 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
						Verified track record.
					</h2>
					<div class="grid gap-6 md:grid-cols-3">
						<article class="on-paper hard flex flex-col justify-between bg-cream text-ink">
							<div>
								<div class="flex items-center gap-3 border-b-[1.5px] border-ink px-2.5 py-1.5">
									<span class="size-3 shrink-0 border-[1.5px] border-ink" aria-hidden="true"></span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
									<span class="font-pixel text-xs leading-none">LOG 01</span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
								</div>
								<div class="p-5">
									<h3 class="text-lg font-bold tracking-[-0.02em]">
										Education at Glokala Folkshögskola
									</h3>
									<blockquote class="mt-3 border-l-[2px] border-ink pl-3 text-sm leading-relaxed opacity-90">
										"Immersed in an in-depth Music Production program, acquiring proficiency in
										recording, mixing, mastering, event planning, and industry-standard practices.
										Produced and released multiple songs, primarily in hip-hop and R&amp;B genres."
									</blockquote>
								</div>
							</div>
							<div class="border-t-[1.5px] border-ink/20 px-5 py-3">
								<p class="label-mono text-[10px]! opacity-70">
									Source: Glokala Folkshögskola (2009)
								</p>
							</div>
						</article>

						<article class="on-paper hard flex flex-col justify-between bg-cream text-ink">
							<div>
								<div class="flex items-center gap-3 border-b-[1.5px] border-ink px-2.5 py-1.5">
									<span class="size-3 shrink-0 border-[1.5px] border-ink" aria-hidden="true"></span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
									<span class="font-pixel text-xs leading-none">LOG 02</span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
								</div>
								<div class="p-5">
									<h3 class="text-lg font-bold tracking-[-0.02em]">
										Music Production Tools 2022
									</h3>
									<blockquote class="mt-3 border-l-[2px] border-ink pl-3 text-sm leading-relaxed opacity-90">
										"My journey in music production has been defined by experimentation and learning
										industry-standard tools. From Reason Studios to Cubase, each DAW has shaped my
										approach to creating beats and designing sounds."
									</blockquote>
								</div>
							</div>
							<div class="border-t-[1.5px] border-ink/20 px-5 py-3">
								<p class="label-mono text-[10px]! opacity-70">
									Source: Field Notes (2022)
								</p>
							</div>
						</article>

						<article class="on-paper hard flex flex-col justify-between bg-cream text-ink">
							<div>
								<div class="flex items-center gap-3 border-b-[1.5px] border-ink px-2.5 py-1.5">
									<span class="size-3 shrink-0 border-[1.5px] border-ink" aria-hidden="true"></span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
									<span class="font-pixel text-xs leading-none">LOG 03</span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
								</div>
								<div class="p-5">
									<h3 class="text-lg font-bold tracking-[-0.02em]">First Official Release</h3>
									<blockquote class="mt-3 border-l-[2px] border-ink pl-3 text-sm leading-relaxed opacity-90">
										"Released my first official track 'The Demo', marking the beginning of my music
										production journey. A milestone that combined technical skills with creative
										expression."
									</blockquote>
								</div>
							</div>
							<div class="border-t-[1.5px] border-ink/20 px-5 py-3">
								<p class="label-mono text-[10px]! opacity-70">
									Source: Life Timeline (2010)
								</p>
							</div>
						</article>
					</div>
				</div>

				<div>
					<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
						<p class="label-mono">/ Impact &amp; outcomes</p>
						<div class="flex items-center gap-3">
							<p class="label-mono hidden opacity-70 sm:block">Key deliverables</p>
							<span class="size-2 bg-current" aria-hidden="true"></span>
						</div>
					</div>
					<h2 class="mt-6 mb-8 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
						Measured outcomes.
					</h2>
					<div class="grid gap-6 md:grid-cols-2">
						<div class="on-paper hard bg-cream p-6 text-ink">
							<div class="font-pixel text-3xl text-ink">15+ Years</div>
							<div class="mt-2 text-lg font-bold tracking-[-0.02em]">
								Music Production Experience
							</div>
							<p class="mt-2 text-sm leading-relaxed opacity-80">
								From first release in 2010 to ongoing creative work with Reason Studios and modern
								audio tools.
							</p>
						</div>

						<div class="on-paper hard bg-cream p-6 text-ink">
							<div class="font-pixel text-3xl text-ink">Multiple Releases</div>
							<div class="mt-2 text-lg font-bold tracking-[-0.02em]">Original Productions</div>
							<p class="mt-2 text-sm leading-relaxed opacity-80">
								Hip-hop and R&amp;B tracks showcasing technical and creative capabilities.
							</p>
						</div>

						<div class="on-paper hard bg-cream p-6 text-ink">
							<div class="font-pixel text-3xl text-ink">Event Organizer</div>
							<div class="mt-2 text-lg font-bold tracking-[-0.02em]">Arena 305 Showcase</div>
							<p class="mt-2 text-sm leading-relaxed opacity-80">
								Organized and hosted a live showcase for Malmö-based artists, demonstrating
								technical and creative leadership.
							</p>
						</div>

						<div class="on-paper hard bg-cream p-6 text-ink">
							<div class="font-pixel text-3xl text-ink">Cross-Domain</div>
							<div class="mt-2 text-lg font-bold tracking-[-0.02em]">Technical + Creative</div>
							<p class="mt-2 text-sm leading-relaxed opacity-80">
								Bridging software development with audio production for interactive web and
								multimedia projects.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="block-mustard section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Creative &amp; technical stacks</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">Audio &amp; multimedia</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-6 mb-10 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
				Creative &amp; technical stacks.
			</h2>
			<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
				{musicStacks.map((stack) => <StackCard {...stack} client:load />)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Competency matrix</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">Studio capabilities</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-6 mb-10 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
				Music production skills.
			</h2>
			<SkillChart data={[musicChart]} chartData={musicChart} client:load />
		</div>
	</section>

	<section class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Studio rack</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">DAWs &amp; signal tools</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-6 mb-10 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
				Music production tools.
			</h2>
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
				{
					musicTools.map((tool, index) => (
						<div class="on-paper hard flex flex-col justify-between bg-cream text-ink">
							<div>
								<div class="flex items-center gap-3 border-b-[1.5px] border-ink px-2.5 py-1.5">
									<span class="size-3 shrink-0 border-[1.5px] border-ink" aria-hidden="true" />
									<span class="stripes h-[13px] flex-1" aria-hidden="true" />
									<span class="font-pixel text-xs leading-none">RACK 0{index + 1}</span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true" />
								</div>
								<div class="p-5">
									<div class="mb-3 flex items-center gap-3">
										<img src={tool.icon} alt={tool.name} class="h-8 w-8 object-contain" />
										<h3 class="text-lg font-bold tracking-[-0.02em]">{tool.name}</h3>
									</div>
									<p class="text-sm leading-relaxed opacity-85">{tool.description}</p>
								</div>
							</div>
							<div class="border-t-[1.5px] border-ink/20 p-4">
								<div class="mb-1.5 flex items-center justify-between">
									<span class="label-mono text-[10px]! opacity-70">Proficiency</span>
									<span class="font-mono text-xs font-bold">{tool.proficiency}/10</span>
								</div>
								<div class="h-2.5 w-full border-[1.5px] border-ink bg-paper">
									<div class="h-full bg-mustard" style={`width: ${tool.proficiency * 10}%`} />
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Studio workflow</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">From sketch to master</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-6 mb-10 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
				Music production process.
			</h2>
			<div class="grid gap-6 md:grid-cols-3">
				<div class="on-paper hard bg-cream p-6 text-ink">
					<span class="font-pixel border-[1.5px] border-ink bg-mustard px-2 py-0.5 text-xs">
						STAGE 01
					</span>
					<h3 class="mt-4 text-xl font-bold tracking-[-0.02em]">Ideation &amp; Composition</h3>
					<p class="mt-2 text-sm leading-relaxed opacity-85">
						Start with musical ideas, create melodies, and build chord progressions using MIDI
						programming and sampling.
					</p>
				</div>

				<div class="on-paper hard bg-cream p-6 text-ink">
					<span class="font-pixel border-[1.5px] border-ink bg-mustard px-2 py-0.5 text-xs">
						STAGE 02
					</span>
					<h3 class="mt-4 text-xl font-bold tracking-[-0.02em]">Production &amp; Mixing</h3>
					<p class="mt-2 text-sm leading-relaxed opacity-85">
						Layer instruments, design custom sounds, apply effects, and balance levels for
						studio-grade clarity.
					</p>
				</div>

				<div class="on-paper hard bg-cream p-6 text-ink">
					<span class="font-pixel border-[1.5px] border-ink bg-mustard px-2 py-0.5 text-xs">
						STAGE 03
					</span>
					<h3 class="mt-4 text-xl font-bold tracking-[-0.02em]">Mastering &amp; Release</h3>
					<p class="mt-2 text-sm leading-relaxed opacity-85">
						Final polish with mastering chains, preparing tracks for distribution across SoundCloud,
						Spotify, and live sets.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 pb-20">
		<div class="grid gap-8 lg:grid-cols-2">
			<div class="on-paper hard bg-cream p-8 text-ink">
				<p class="label-mono">/ Audio archive</p>
				<h3 class="mt-3 text-2xl font-bold tracking-[-0.03em] md:text-3xl">
					Listen on SoundCloud
				</h3>
				<p class="mt-3 text-base leading-relaxed opacity-85">
					Explore my hip-hop and R&amp;B instrumentals produced with Reason Studios and hardware
					synths.
				</p>
				<div class="mt-6 flex flex-wrap gap-3">
					<a
						href="https://soundcloud.com/eprumental"
						target="_blank"
						rel="noopener noreferrer"
						class="key bg-ink text-cream"
					>
						Open SoundCloud
					</a>
					<a href="/music" class="key bg-cream text-ink">
						Studio booth
					</a>
				</div>
			</div>

			<div class="block-cobalt hard flex flex-col justify-between p-8 text-ink">
				<div>
					<p class="label-mono">/ Collaborate</p>
					<h3 class="mt-3 text-2xl font-bold tracking-[-0.03em] md:text-3xl">
						Ready to collaborate on a creative project?
					</h3>
					<p class="mt-3 text-base leading-relaxed opacity-90">
						Available for custom sound design, interactive web audio, and production projects.
					</p>
				</div>
				<div class="mt-6">
					<a href="/contact" class="key bg-ink text-cream">
						Call the studio
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

