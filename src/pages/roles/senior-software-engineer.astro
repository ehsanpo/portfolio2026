---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/hero/Hero.astro";
import StackCard from "@/components/StackCard";
import SkillChart from "@/components/SkillChart";
import ToolsList from "@/components/skills/ToolsList.astro";
import { ProcessFlowDiagram } from "@/components/Beams";
import { getPortfolioData, getRoles } from "@/utils/data";
import { getRoleImage } from "@/utils/roleImageMap";

const { stacks } = getPortfolioData();
const roles = getRoles();
const currentRole = roles.find((role) => role.slug === "senior-software-engineer");
const mappedImage = currentRole?.image ? getRoleImage(currentRole.image) : undefined;
const displayImage = mappedImage && {
	src: mappedImage.src,
	alt: currentRole?.title,
	width: mappedImage.width,
	height: mappedImage.height,
};

const seniorStacks = stacks.filter((stack) =>
	["Front-end", "Backend", "Database", "DevOps"].includes(stack.slug)
);

const seniorChart = {
	slug: "Senior Engineering",
	labels: [
		"Code Quality",
		"System Design",
		"Mentorship",
		"Technical Leadership",
		"Best Practices",
		"Innovation",
	],
	data: ["10", "9", "10", "9", "10", "9"],
};
---

<Layout title="Senior Software Engineer - Ehsan Pourhadi">
	<Hero fullHeight title="Senior Software Engineer" img={displayImage?.src}>
		<div class="space-y-4">
			<p class="text-xl font-medium leading-snug">
				{currentRole?.description}
			</p>
			<p class="text-base leading-relaxed opacity-85">
				With 12+ years of software development experience, I have evolved from building features to
				architecting systems and mentoring teams. I write production-quality code, make sound
				technical decisions, and share knowledge to elevate team capabilities.
			</p>
		</div>
	</Hero>

	<section class="section">
		<div class="container mx-auto px-4">
			<div class="mx-auto max-w-[96rem] space-y-20">
				<div>
					<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
						<p class="label-mono">/ What I bring</p>
						<div class="flex items-center gap-3">
							<p class="label-mono hidden opacity-70 sm:block">Core approach</p>
							<span class="size-2 bg-current" aria-hidden="true"></span>
						</div>
					</div>
					<h2 class="mt-6 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
						Architecture, execution &amp; mentorship.
					</h2>
					<p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted-foreground">
						With 12+ years of software development experience, I have evolved from building features
						to architecting systems and mentoring teams. I write production-quality code, make sound
						technical decisions, and share knowledge to elevate team capabilities. I balance
						technical depth with pragmatic delivery.
					</p>
				</div>

				<div>
					<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
						<p class="label-mono">/ Evidence</p>
						<div class="flex items-center gap-3">
							<p class="label-mono hidden opacity-70 sm:block">On the record</p>
							<span class="size-2 bg-current" aria-hidden="true"></span>
						</div>
					</div>
					<h2 class="mt-6 mb-8 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
						Verified track record.
					</h2>
					<div class="grid gap-6 md:grid-cols-3">
						<article class="on-paper hard flex flex-col justify-between bg-cream text-ink">
							<div>
								<div class="flex items-center gap-3 border-b-[1.5px] border-ink px-2.5 py-1.5">
									<span class="size-3 shrink-0 border-[1.5px] border-ink" aria-hidden="true"></span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
									<span class="font-pixel text-xs leading-none">LOG 01</span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
								</div>
								<div class="p-5">
									<h3 class="text-lg font-bold tracking-[-0.02em]">Experience at Telavox</h3>
									<blockquote class="mt-3 border-l-[2px] border-ink pl-3 text-sm leading-relaxed opacity-90">
										"Collaborated on the development of various software projects using React, Java,
										and ElectronJs. Contributed to the design and architecture of web applications."
									</blockquote>
								</div>
							</div>
							<div class="border-t-[1.5px] border-ink/20 px-5 py-3">
								<p class="label-mono text-[10px]! opacity-70">
									Source: Telavox (2023 to 2025)
								</p>
							</div>
						</article>

						<article class="on-paper hard flex flex-col justify-between bg-cream text-ink">
							<div>
								<div class="flex items-center gap-3 border-b-[1.5px] border-ink px-2.5 py-1.5">
									<span class="size-3 shrink-0 border-[1.5px] border-ink" aria-hidden="true"></span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
									<span class="font-pixel text-xs leading-none">LOG 02</span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
								</div>
								<div class="p-5">
									<h3 class="text-lg font-bold tracking-[-0.02em]">
										Heshan Kithuldora (Software Developer)
									</h3>
									<blockquote class="mt-3 border-l-[2px] border-ink pl-3 text-sm leading-relaxed opacity-90">
										"Ehsan is a highly experienced engineer with strong technical expertise across
										both front-end and back-end development. He often took the lead on new
										initiatives and helped establish effective ways of working within the team."
									</blockquote>
								</div>
							</div>
							<div class="border-t-[1.5px] border-ink/20 px-5 py-3">
								<p class="label-mono text-[10px]! opacity-70">
									Source: Testimonial, Telavox
								</p>
							</div>
						</article>

						<article class="on-paper hard flex flex-col justify-between bg-cream text-ink">
							<div>
								<div class="flex items-center gap-3 border-b-[1.5px] border-ink px-2.5 py-1.5">
									<span class="size-3 shrink-0 border-[1.5px] border-ink" aria-hidden="true"></span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
									<span class="font-pixel text-xs leading-none">LOG 03</span>
									<span class="stripes h-[13px] flex-1" aria-hidden="true"></span>
								</div>
								<div class="p-5">
									<h3 class="text-lg font-bold tracking-[-0.02em]">
										Asger Bjerre-Nielsen (Developer)
									</h3>
									<blockquote class="mt-3 border-l-[2px] border-ink pl-3 text-sm leading-relaxed opacity-90">
										"Ehsan has excellent ability to break down tasks and problems and provide high
										quality code to efficiently solve even the most demanding task. He is always on
										the lookout for new tech and ideas, on how to do things better."
									</blockquote>
								</div>
							</div>
							<div class="border-t-[1.5px] border-ink/20 px-5 py-3">
								<p class="label-mono text-[10px]! opacity-70">
									Source: Testimonial, Bredband2
								</p>
							</div>
						</article>
					</div>
				</div>

				<div>
					<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
						<p class="label-mono">/ Impact &amp; outcomes</p>
						<div class="flex items-center gap-3">
							<p class="label-mono hidden opacity-70 sm:block">Key deliverables</p>
							<span class="size-2 bg-current" aria-hidden="true"></span>
						</div>
					</div>
					<h2 class="mt-6 mb-8 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
						Measured outcomes.
					</h2>
					<div class="grid gap-6 md:grid-cols-2">
						<div class="on-paper hard bg-cream p-6 text-ink">
							<div class="font-pixel text-3xl text-ink">12+ Years</div>
							<div class="mt-2 text-lg font-bold tracking-[-0.02em]">Professional Experience</div>
							<p class="mt-2 text-sm leading-relaxed opacity-80">
								Full-stack development across multiple companies and production architectures.
							</p>
						</div>

						<div class="on-paper hard bg-cream p-6 text-ink">
							<div class="font-pixel text-3xl text-ink">Technical Lead</div>
							<div class="mt-2 text-lg font-bold tracking-[-0.02em]">Initiative &amp; Innovation</div>
							<p class="mt-2 text-sm leading-relaxed opacity-80">
								Leading new initiatives and establishing engineering best practices for teams.
							</p>
						</div>

						<div class="on-paper hard bg-cream p-6 text-ink">
							<div class="font-pixel text-3xl text-ink">Mentorship</div>
							<div class="mt-2 text-lg font-bold tracking-[-0.02em]">Knowledge Sharing</div>
							<p class="mt-2 text-sm leading-relaxed opacity-80">
								Mentoring developers and conducting code reviews to elevate team quality.
							</p>
						</div>

						<div class="on-paper hard bg-cream p-6 text-ink">
							<div class="font-pixel text-3xl text-ink">Architecture</div>
							<div class="mt-2 text-lg font-bold tracking-[-0.02em]">System Design</div>
							<p class="mt-2 text-sm leading-relaxed opacity-80">
								Designing scalable architectures for complex web and desktop applications.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="block-mustard section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Technical expertise</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">Core stack</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-6 mb-10 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
				Production stack.
			</h2>
			<div class="grid gap-8 md:grid-cols-2">
				{seniorStacks.map((stack) => <StackCard {...stack} client:load />)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Competency matrix</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">Senior engineering</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-6 mb-10 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
				Senior engineering skills.
			</h2>
			<SkillChart data={[seniorChart]} chartData={seniorChart} client:load />
		</div>
	</section>

	<ToolsList />

	<section class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Engineering workflow</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">From spec to release</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-6 mb-10 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
				Development process.
			</h2>
			<ProcessFlowDiagram client:load />
		</div>
	</section>

	<section class="container mx-auto px-4 pb-20">
		<div class="block-cobalt hard p-8 text-ink md:p-12">
			<div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
				<div>
					<p class="label-mono">/ Collaborate</p>
					<h3 class="mt-3 text-3xl font-bold tracking-[-0.04em] md:text-4xl">
						Ready to elevate your engineering team?
					</h3>
				</div>
				<a href="/contact" class="key shrink-0 bg-ink text-cream">
					Call the studio
				</a>
			</div>
		</div>
	</section>
</Layout>

