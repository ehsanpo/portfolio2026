---
import Layout from "../layouts/Layout.astro";
import SkillChart from "../components/SkillChart";
import RankTimeline from "@/components/RankTimeline";
import { getPortfolioData } from "@/utils/data";
import Certificates from "@/blocks/CertificatesBlock.astro";
import ToolsList from "@/components/skills/ToolsList.astro";
import PageHero from "@/components/hero/PageHero.astro";
import TechStackBlock from "@/blocks/TechStackBlock.astro";
import { ProcessFlowDiagram } from "@/components/Beams";
import GitHubContributionsBlock from "@/blocks/GitHubContributionsBlock.astro";

const { stacks, charts } = getPortfolioData();
---

<Layout title="Skills - Developer Portfolio">
	<PageHero
		title="Skills & Tools"
		subtitle="My technical expertise and proficiency across different technologies"
	/>
	<TechStackBlock showAll />

	<section id="skills-chart" class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Skills chart</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">Interactive radar</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-8 mb-10 max-w-3xl text-4xl md:text-5xl font-bold tracking-[-0.04em]">
				Skills Chart.
			</h2>
			<SkillChart data={stacks} chartData={charts[0]} client:load showButtons={true} />
		</div>
	</section>

	<section id="tech-timeline" class="block-cobalt section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Tech timeline</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">2010 to 2026</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-8 max-w-3xl text-4xl md:text-5xl font-bold tracking-[-0.04em]">
				Tech Timeline.
			</h2>
			<RankTimeline client:visible />
		</div>
	</section>

	<ToolsList />
	<GitHubContributionsBlock />

	<section id="development-process" class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Development process</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">Inputs to delivery</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<h2 class="mt-8 mb-10 max-w-3xl text-4xl md:text-5xl font-bold tracking-[-0.04em]">
				Development Process.
			</h2>
			<ProcessFlowDiagram client:load />
		</div>
	</section>

	<Certificates showAll />
</Layout>
