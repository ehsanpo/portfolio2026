---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/hero/PageHero.astro";
import SocialGridFeed from "@/components/social/SocialGridFeed";
import { getSocialPosts } from "@/utils/social";

const socialPosts = await getSocialPosts();
---

<Layout
	title="Social"
	description="Design drops, short videos, and useful links in one TikTok-style feed."
>
	<PageHero title="Social" subtitle="Images, videos, links, and quick drops from my creative workflow." />

	<section class="section">
		<div class="container">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Feed &amp; dispatches</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">{socialPosts.length} posts</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>
			<div class="mt-8">
				<SocialGridFeed posts={socialPosts} client:load />
			</div>
		</div>
	</section>
</Layout>
