---
import Layout from "@/layouts/Layout.astro";
import { WorkCard } from "@/components/work/WorkCard";
import { Reveal } from "@/components/motion/Reveal";
import portfolioData from "@/data/portfolio-resume.json";
import PageHero from "@/components/hero/PageHero.astro";

const companies = portfolioData.companies;
---

<Layout title="Work & Experience" description="Work Experience and Professional Career">
	<PageHero
		title="Work & experience"
		subtitle="Thirteen+ years across product companies, agencies, and technical leadership roles."
	/>
	<section class="section">
		<div class="container mx-auto px-4">
			<div class="flex items-center justify-between border-t-[1.5px] border-current pt-3">
				<p class="label-mono">/ Career record</p>
				<div class="flex items-center gap-3">
					<p class="label-mono hidden opacity-70 sm:block">{companies.length} organizations</p>
					<span class="size-2 bg-current" aria-hidden="true"></span>
				</div>
			</div>

			<div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
				{
					companies.map((company, index) => (
						<Reveal
							client:visible
							delay={Math.min(index * 0.06, 0.3)}
							className="h-full"
						>
							<WorkCard
								title={company.name}
								position={company.position}
								year={company.year}
								description={company.description}
								tags={company.tags}
								image={
									company.image
										? {
												src: company.image,
												alt: company.name,
												width: 800,
												height: 600,
											}
										: undefined
								}
								href={`/work/${company.id}`}
							/>
						</Reveal>
					))
				}
			</div>
		</div>
	</section>
</Layout>
